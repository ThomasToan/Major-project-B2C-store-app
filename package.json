{
  "name": "thomas-store",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "db:push:test": "pnpm --filter @repo/db db:push:test",
    "seed:test": "pnpm --filter @repo/db seed:test",
    "studio:test": "pnpm --filter @repo/db studio:test",
    "lint": "turbo lint",
    "test:b2c": "turbo test:b2c",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.3.1"
  }
}
