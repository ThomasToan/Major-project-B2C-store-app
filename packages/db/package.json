{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "pnpm build && node -e \"require('./dist/seed.js').seed().then(() => process.exit(0)).catch((error) => { console.error(error); process.exit(1); })\"",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "pnpm db:generate",
    "predev": "pnpm db:generate",
    "postinstall": "pnpm db:generate",
    "studio": "prisma studio",
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./data": {
      "types": "./src/data.ts",
      "default": "./dist/data.js"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "default": "./dist/seed.js"
    },
    "./store": {
      "types": "./src/store.ts",
      "default": "./dist/store.js"
    }
  },
  "dependencies": {
    "@repo/env": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@types/node": "^22.13.1",
    "vitest": "^3.0.4"
  }
}
